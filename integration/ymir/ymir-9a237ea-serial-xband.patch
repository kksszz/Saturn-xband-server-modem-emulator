+void SH2::SCITransmitByte(uint8 value) {
+    SCI.SSR &= ~(SerialCommunicationInterface::kTDRE | SerialCommunicationInterface::kTEND);
+    SCI.observedStatus &= ~SerialCommunicationInterface::kTDRE;
+    SCI.TDR = value;
+    if (!SCI.txBusy) {
+        // An idle SCI moves TDR into the shift register and makes TDR empty
+        // before the frame finishes on the wire.
+        SCI.txValue = value;
+        SCI.txCompleteCycle = GetCurrentCycleCount() + SCI.TransmitCycles();
+        SCI.txBusy = true;
+        SCI.SSR |= SerialCommunicationInterface::kTDRE;
+    }
+    RecalcInterrupts();
+}
+
+void SH2::AdvanceSCI() {
+    const uint64 now = GetCurrentCycleCount();
+    while (SCI.txBusy && now >= SCI.txCompleteCycle) {
+        m_cbSCITransmit(SCI.txValue);
+        if (!(SCI.SSR & SerialCommunicationInterface::kTDRE)) {
+            // The guest filled TDR during this frame. Continue with the
+            // buffered byte without asserting transmit-end.
+            SCI.txValue = SCI.TDR;
+            SCI.txCompleteCycle += SCI.TransmitCycles();
+            SCI.SSR |= SerialCommunicationInterface::kTDRE;
+        } else {
+            SCI.txBusy = false;
+            SCI.SSR |= SerialCommunicationInterface::kTEND;
+        }
+        RecalcInterrupts();
+    }
+}
