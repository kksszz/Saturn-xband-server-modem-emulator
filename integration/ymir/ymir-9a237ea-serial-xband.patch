+bool SH2::SCIReceiveByte(uint8 value) {
+    const bool wasEnabled = SCI.SCR & SerialCommunicationInterface::kRE;
+    const bool wasFull = SCI.SSR & SerialCommunicationInterface::kRDRF;
+    const bool accepted = SCI.ReceiveByte(value);
+    TraceSCI(accepted ? 'A' : 'X', value);
+    if (accepted) {
+        ++m_sciDiagnostics.received;
+        SCI.rxReadyCycle = GetCurrentCycleCount() + SCI.TransmitCycles();
+    } else if (wasEnabled && wasFull) {
+        ++m_sciDiagnostics.receiveOverruns;
+    }
+    if (SCI.SCR & SerialCommunicationInterface::kRE) {
+        RecalcInterrupts();
+    }
+    return accepted;
