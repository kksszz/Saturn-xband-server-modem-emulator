diff --git a/apps/ymir-sdl3/src/app/debug/xband_access_logger.hpp b/apps/ymir-sdl3/src/app/debug/xband_access_logger.hpp
new file mode 100644
index 0000000..1ee0280
--- /dev/null
+++ b/apps/ymir-sdl3/src/app/debug/xband_access_logger.hpp
@@ -0,0 +1,118 @@
+#pragma once
+
+#include <ymir/core/types.hpp>
+#include <chrono>
+#include <condition_variable>
+#include <deque>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace app::xband {
+
+// Passive, bounded development trace. No emulated modem responses, AT parsing,
+// TCP connection or game patches. Disk I/O stays off the emulation thread.
+class XBandAccessLogger {
+public:
+    ~XBandAccessLogger() { Stop(); }
+    bool Start(const std::filesystem::path &path) {
+        Stop();
+        m_file.open(path, std::ios::out | std::ios::trunc);
+        if (!m_file) return false;
+        m_file << "# xband-passive-v1; no modem emulation; registers are unverified candidates\n"
+               << "# CPU external-bus accesses only; debugger peeks/pokes and SCU DMA excluded\n"
+               << "host_us,cpu,cycle,pc,address,physical,width,rw,value,category,register_candidate\n";
+        m_start = std::chrono::steady_clock::now();
+        m_stop = false;
+        m_accepted = m_dropped = m_smpcAccepted = 0;
+        m_worker = std::thread([this] { Run(); });
+        return true;
+    }
+    void Stop() {
+        {
+            std::lock_guard lock{m_mutex};
+            m_stop = true;
+        }
+        m_cv.notify_all();
+        if (m_worker.joinable()) m_worker.join();
+        if (m_file.is_open()) m_file.close();
+    }
+    void Record(bool master, bool write, uint32 address, uint32 value, uint8 width, uint32 pc, uint64 cycle,
+                bool codeSnapshot = false) {
+        std::lock_guard lock{m_mutex};
+        if (m_stop) return;
+        // Keep busy SMPC polling from consuming the modem investigation budget.
+        const uint32 physical = address & 0x07FFFFFF;
+        const bool smpc = physical >= 0x00100000 && physical <= 0x0010007F;
+        if (smpc && m_smpcAccepted >= 20000) { ++m_dropped; return; }
+        if (m_accepted >= 200000 || m_queue.size() >= 16384) { ++m_dropped; return; }
+        const auto us = std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::steady_clock::now() - m_start).count();
+        m_queue.push_back({us, cycle, pc, address, value, width, master, write, codeSnapshot});
+        ++m_accepted;
+        if (smpc) ++m_smpcAccepted;
+        m_cv.notify_one();
+    }
+private:
+    struct Event {
+        int64_t us; uint64 cycle; uint32 pc, address, value; uint8 width; bool master, write, codeSnapshot;
+    };
+    static const char *Category(uint32 address) {
+        if (address >= 0x00100000 && address <= 0x0010007F) return "SMPC";
+        if (address >= 0x04FFFFFC && address <= 0x04FFFFFF) return "CART_ID";
+        return "MODEM_CANDIDATE";
+    }
+    static const char *Register(uint32 address) {
+        if (address == 0x0010001F) return "SMPC_COMREG";
+        if (address == 0x00100063) return "SMPC_SF";
+        if (address == 0x0582503D) return "ACK_candidate";
+        if (address >= 0x05895000 && address <= 0x0589503F && (address & 3) == 1) {
+            static constexpr const char *names[]{"RBR_THR_DLL?", "IER_DLM?", "IIR_FCR?", "LCR?",
+                                                  "MCR?", "LSR?", "MSR?", "SCR?"};
+            return names[((address - 0x05895001) >> 2) & 7];
+        }
+        return "unknown";
+    }
+    void Run() {
+        for (;;) {
+            std::deque<Event> batch;
+            bool finish;
+            uint64 dropped;
+            {
+                std::unique_lock lock{m_mutex};
+                m_cv.wait_for(lock, std::chrono::milliseconds(100), [&] { return m_stop || !m_queue.empty(); });
+                batch.swap(m_queue);
+                finish = m_stop;
+                dropped = m_dropped;
+            }
+            for (const auto &e : batch) {
+                const uint32 physical = e.address & 0x07FFFFFF;
+                m_file << std::dec << e.us << ',' << (e.master ? "master" : "slave") << ',' << e.cycle
+                       << ",0x" << std::hex << e.pc << ",0x" << e.address << ",0x" << physical << ','
+                       << std::dec << unsigned(e.width) << ',' << (e.write ? 'W' : 'R') << ",0x"
+                       << std::hex << e.value << ',' << (e.codeSnapshot ? "CODE_SNAPSHOT" : Category(physical))
+                       << ',' << (e.codeSnapshot ? "peek_not_bus_access" : Register(physical)) << '\n';
+            }
+            if (finish) m_file << "# end,accepted," << std::dec << m_accepted << ",dropped," << dropped << '\n';
+            m_file.flush();
+            if (finish) break;
+            if (!m_file) {
+                std::lock_guard lock{m_mutex};
+                m_stop = true;
+                break;
+            }
+        }
+    }
+    std::ofstream m_file;
+    std::thread m_worker;
+    std::mutex m_mutex;
+    std::condition_variable m_cv;
+    std::deque<Event> m_queue;
+    bool m_stop = true;
+    uint64 m_accepted = 0, m_dropped = 0;
+    uint64 m_smpcAccepted = 0;
+    std::chrono::steady_clock::time_point m_start{};
+};
+} // namespace app::xband
