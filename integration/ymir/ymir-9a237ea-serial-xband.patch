diff --git a/apps/ymir-sdl3/src/app/ui/views/settings/serial_port_settings_view.cpp b/apps/ymir-sdl3/src/app/ui/views/settings/serial_port_settings_view.cpp
new file mode 100644
index 0000000..4b5be76
--- /dev/null
+++ b/apps/ymir-sdl3/src/app/ui/views/settings/serial_port_settings_view.cpp
@@ -0,0 +1,134 @@
+#include "serial_port_settings_view.hpp"
+
+#include <algorithm>
+#include <imgui.h>
+#ifdef YMIR_XBAND_FRONTEND
+#include <frontend_modem.hpp>
+#include <app/events/emu_event_factory.hpp>
+#include <cstdio>
+#include <cstdlib>
+#endif
+
+namespace app::ui {
+
+SerialPortSettingsView::SerialPortSettingsView(SharedContext &context, services::LinkCableService &linkCableService)
+    : SettingsViewBase(context)
+    , m_linkCableService(linkCableService) {
+    // Keep framed dual-lane sessions away from older raw-byte preview builds.
+    if (m_linkCableService.UsesDualSCI()) m_port = 32458;
+}
+
+void SerialPortSettingsView::EnableLocalAuto() {
+    m_enabled = true;
+    m_mode = 0;
+    if (m_linkCableService.UsesDualSCI()) m_port = 32458;
+    else if (m_linkCableService.UsesSynchronization()) m_port = 32457;
+    m_linkCableService.AutoConnectLocal(static_cast<uint16>(m_port));
+}
+
+void SerialPortSettingsView::Display() {
+#ifdef YMIR_XBAND_FRONTEND
+    auto &modem=m_context.serviceLocator.GetRequired<::xband::ymir_adapter::FrontendModem>();
+    const auto modemState=modem.snapshot();
+    ImGui::SeparatorText("XBAND cartridge modem (preview)");
+    ImGui::TextWrapped("Separate from the battle cable. Requires the private preview server. Settings apply to this session only.");
+    ImGui::BeginDisabled(modemState.enabled);
+    ImGui::InputText("Server IPv4",m_modemHost,sizeof(m_modemHost));
+    ImGui::InputInt("Server base port",&m_modemPort);
+    ImGui::Checkbox("Allow private LAN (plain TCP)",&m_modemLAN);
+    ImGui::Combo("Modem endpoint",&m_modemSide,"Saturn 1\0Saturn 2\0");
+    ImGui::InputText("Own telephone number",m_modemPhone,sizeof(m_modemPhone));
+    ImGui::EndDisabled();
+    ImGui::BeginDisabled(!modemState.enabled && m_modemPhone[0]=='\0');
+    if(ImGui::Button(modemState.enabled?"Disconnect modem":"Connect modem")){
+        ::xband::ymir_adapter::FrontendModem::Config config;
+        config.enabled=!modemState.enabled;config.address=m_modemHost;config.port=m_modemPort;
+        config.side=m_modemSide;config.phone=m_modemPhone;config.allowLAN=m_modemLAN;
+        if(config.enabled){m_linkCableService.Disconnect();m_enabled=false;}
+        modem.request(std::move(config));
+        m_context.EnqueueEvent(events::emu::RunFunction([](SharedContext&){}));
+    }
+    ImGui::EndDisabled();
+    ImGui::TextWrapped("Modem: %s",modemState.status.c_str());
+    ImGui::Text("Carrier: %s | TX %llu | RX %llu",modemState.carrier?"ON":"OFF",
+        static_cast<unsigned long long>(modemState.sent),static_cast<unsigned long long>(modemState.received));
+    ImGui::TextWrapped("Enter a distinct telephone number for each endpoint. Connect before booting the game. Reset/load-state during a call requires a new server session.");
+    ImGui::SeparatorText("Virtual media card (experimental)");
+    ImGui::TextWrapped("Explicit 13-byte card image only. No identity generation, automatic refill or server charging policy. Card bytes persist independently of game save states.");
+    ImGui::BeginDisabled(modemState.enabled||modemState.virtualCardConfigured);
+    ImGui::InputText("Card image path (UTF-8)",m_virtualCardPath,sizeof(m_virtualCardPath));
+    ImGui::BeginDisabled(m_virtualCardPath[0]=='\0');
+    if(ImGui::Button("Load card image")){
+        modem.requestCardImage(std::filesystem::u8path(m_virtualCardPath));
+        m_context.EnqueueEvent(events::emu::RunFunction([](SharedContext&){}));
+    }
+    ImGui::EndDisabled();ImGui::EndDisabled();
+    ImGui::TextWrapped("Load while the modem is disconnected. Restart Ymir to select a different card image. Loading alone does not insert the card.");
+    ImGui::BeginDisabled(!modemState.virtualCardConfigured);
+    if(ImGui::Button(modemState.virtualCardInserted?"Eject virtual card":"Insert virtual card")){
+        modem.requestCardInsertion(!modemState.virtualCardInserted);
+        m_context.EnqueueEvent(events::emu::RunFunction([](SharedContext&){}));
+    }
+    ImGui::EndDisabled();
+    ImGui::Text("Card: %s",!modemState.virtualCardConfigured?"not configured":modemState.virtualCardInserted?"inserted":"ejected");
+    ImGui::SeparatorText("Battle cable");
+#endif
+    ImGui::TextWrapped("Connect two Ymir instances before entering a link battle. "
+                       "On one PC, both instances can pair automatically.");
+    ImGui::SeparatorText("Connection");
+
+    auto &settings = GetSettings();
+    bool synchronized = settings.general.linkSynchronization == 1;
+    if (ImGui::Checkbox("Synchronize linked emulation (restart required)", &synchronized)) {
+        settings.general.linkSynchronization = synchronized ? 1 : 0;
+        MakeDirty();
+    }
+    ImGui::TextWrapped("Use the same setting on both instances. Restart both after changing it. "
+                       "ON improves timing consistency but may reduce speed.");
+    if (synchronized != m_linkCableService.UsesSynchronization()) {
+        ImGui::TextUnformatted("Pending change: restart Ymir to apply. Current connection is unchanged.");
+    }
+
+    ImGui::BeginDisabled(m_enabled);
+    ImGui::Combo("Mode", &m_mode, "Same PC (automatic)\0LAN host (listen)\0LAN client (connect)\0");
+    if (m_mode == 2) {
+        ImGui::InputText("Host IPv4 address", m_host, sizeof(m_host));
+    }
+    ImGui::InputInt("TCP port", &m_port);
+    m_port = std::clamp(m_port, 1, 65535);
+    ImGui::EndDisabled();
+
+    if (ImGui::Checkbox("Enable Battle (Taisen) Cable", &m_enabled)) {
+        if (m_enabled) {
+            switch (m_mode) {
+            case 0: m_linkCableService.AutoConnectLocal(static_cast<uint16>(m_port)); break;
+            case 1: m_linkCableService.Listen(static_cast<uint16>(m_port)); break;
+            case 2: m_linkCableService.Connect(m_host, static_cast<uint16>(m_port)); break;
+            }
+        } else {
+            m_linkCableService.Disconnect();
+            m_context.DisplayMessage("Battle (Taisen) Cable disconnected");
+        }
+    }
+
+    const auto state = m_linkCableService.GetState();
+    const char *status = "Disconnected";
+    switch (state) {
+    case services::LinkCableService::State::Disconnected: break;
+    case services::LinkCableService::State::Listening: status = "Listening"; break;
+    case services::LinkCableService::State::Connecting: status = "Connecting"; break;
+    case services::LinkCableService::State::Connected: status = "Connected"; break;
+    case services::LinkCableService::State::Error: status = "Error"; break;
+    }
+    ImGui::Text("Status: %s", status);
+    if (m_linkCableService.UsesSynchronization()) {
+        ImGui::Text("Synchronization: %s",
+                    state != services::LinkCableService::State::Connected ? "inactive" :
+                    m_linkCableService.IsSyncWaiting() ? "waiting for peer" : "active");
+    }
+    if (state == services::LinkCableService::State::Error) {
+        ImGui::TextWrapped("%s", m_linkCableService.GetError().c_str());
+    }
+}
+
+} // namespace app::ui
